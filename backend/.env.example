# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# Database (default: SQLite; set to PostgreSQL URL for production)
# Example: postgres://user:password@localhost:5432/poker_its
DATABASE_URL=

# Anthropic API Key (for LLM Tutor - Module 5)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Instructor dashboard access (comma-separated usernames).
# `manage.py promote_staff` reads this and sets is_staff on those accounts,
# which is what unlocks /admin in the SPA and the /api/admin/ endpoints.
# The accounts must already exist — register them through the app's signup page
# first, so no password ever has to live in an environment variable.
# Run it after migrate in the deploy/build step:
#   python manage.py migrate && python manage.py promote_staff
STAFF_USERNAMES=
